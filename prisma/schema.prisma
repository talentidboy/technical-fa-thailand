// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ข้อมูลประจำตัวผู้ฝึกสอน
model Coach {
  id             Int       @id @default(autoincrement())
  afcId          String?   @unique @map("afc_id")
  nameTh         String    @map("name_th")
  surnameTh      String    @map("surname_th")
  nameEn         String?   @map("name_en")
  familyNameEn   String?   @map("family_name_en")
  gender         String?
  dob            DateTime?
  idNumber       String?   @map("id_number")
  passportNumber String?   @map("passport_number")
  email          String?
  telNo          String?   @map("tel_no")
  nationality    String? // ข้อมูลเดิมเป็นข้อความอิสระ — ใช้ nationalityCode แทนสำหรับข้อมูลใหม่
  residence      String? // ข้อมูลเดิมเป็นข้อความอิสระ — ใช้ provinceCode/districtCode/subdistrictCode แทนสำหรับข้อมูลใหม่
  nationalityCode String?  @map("nationality_code") // ISO 3166-1 alpha-2 เช่น "TH"
  provinceCode    String?  @map("province_code") // รหัสจังหวัดจาก geothai
  districtCode    String?  @map("district_code") // รหัสอำเภอจาก geothai
  subdistrictCode String?  @map("subdistrict_code") // รหัสตำบลจาก geothai
  photoUrl       String?   @map("photo_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  licenseRecords      LicenseRecord[]
  employments         Employment[]
  systemUser          SystemUser?
  profileEditRequests ProfileEditRequest[]
  applications        Application[]

  @@map("coaches")
}

// ประวัติการถือครองใบอนุญาต
// licenseType: PRO, A, B, C, G, ELITE_YOUTH, GK, VDO
// recordType: TRAINING, EQUALIZATION
model LicenseRecord {
  id            Int       @id @default(autoincrement()) @map("record_id")
  coachId       Int       @map("coach_id")
  coach         Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  licenseType   String    @map("license_type")
  recordType    String    @map("record_type")
  isLevelUp     Boolean   @default(false) @map("is_level_up")
  certificateNo String?   @map("certificate_no")
  issueDate     DateTime? @map("issue_date")
  expireDate    DateTime? @map("expire_date")
  confirmedBy   String?   @map("confirmed_by")
  instructorId  Int?      @map("instructor_id")
  instructor    Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("license_records")
}

// ข้อมูลวิทยากรผู้สอนหลักสูตรอบรมผู้ฝึกสอน
// maxLevel: ระดับสูงสุดที่สอนได้ (PRO, A, B, C, G, ELITE_YOUTH, GK, VDO)
model Instructor {
  id              Int      @id @default(autoincrement())
  name            String
  email           String?
  telNo           String?  @map("tel_no")
  photoUrl        String?  @map("photo_url")
  affiliation     String?
  afcInstructorId String?  @map("afc_instructor_id")
  maxLevel        String?  @map("max_level")
  teachesCore       Boolean @default(false) @map("teaches_core")
  teachesGoalkeeper Boolean @default(false) @map("teaches_goalkeeper")
  teachesFitness    Boolean @default(false) @map("teaches_fitness")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  licenseRecords LicenseRecord[]

  @@map("instructors")
}

// ประวัติการทำงานปัจจุบัน
model Employment {
  id         Int      @id @default(autoincrement()) @map("employment_id")
  coachId    Int      @map("coach_id")
  coach      Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clubName   String   @map("club_name")
  division   String?
  position   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("employments")
}

// ระบบจัดการสิทธิ์ผู้ใช้งาน
// role: ADMIN, STAFF, COACH
model SystemUser {
  id           Int       @id @default(autoincrement()) @map("user_id")
  coachId      Int?      @unique @map("coach_id")
  coach        Coach?    @relation(fields: [coachId], references: [id])
  email        String    @unique
  role         String    @default("STAFF")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions         Session[]
  announcements    Announcement[]
  trainingArticles TrainingArticle[]

  @@map("system_users")
}

// ข่าวประกาศที่แสดงบนหน้าหลักสาธารณะ
model Announcement {
  id        Int        @id @default(autoincrement())
  title     String
  excerpt   String
  content   String     @default("")
  imageUrl  String?    @map("image_url")
  linkUrl   String?    @map("link_url")
  tag       String?
  authorId  Int?       @map("author_id")
  author    SystemUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("announcements")
}

// บทความวิเคราะห์เทคนิคของหมวด Training Centre
// area: THE_GAME, PRACTICE, ENVIRONMENT
model TrainingArticle {
  id            Int        @id @default(autoincrement())
  title         String
  area          String
  theme         String?
  ageGroup      String?    @map("age_group")
  excerpt       String
  content       String     @default("")
  coverImageUrl String?    @map("cover_image_url")
  authorId      Int?       @map("author_id")
  author        SystemUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("training_articles")
}

model Session {
  id           Int        @id @default(autoincrement())
  sessionToken String     @unique @map("session_token")
  userId       Int        @map("user_id")
  user         SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime   @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("sessions")
}

// คำขอแก้ไขข้อมูลจากโค้ช ที่รออนุมัติจากแอดมิน
// status: PENDING, APPROVED, REJECTED
model ProfileEditRequest {
  id          Int       @id @default(autoincrement())
  coachId     Int       @map("coach_id")
  coach       Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  payload     String
  message     String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@map("profile_edit_requests")
}

// หลักสูตร (ผูกกับระดับใบอนุญาตหลัก 1 ระดับ — G, C, B, A, PRO)
// หลักสูตร — courseType: LICENSE (ผูกกับระดับใบอนุญาตหลัก 1 ระดับ G/C/B/A/PRO) หรือ GENERAL (อบรมทั่วไป เปิดรับทุกระดับ ไม่มี licenseType)
model Course {
  id          Int      @id @default(autoincrement())
  courseType  String   @default("LICENSE") @map("course_type")
  licenseType String?  @unique @map("license_type")
  title       String
  description String?
  requirement String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  sessions CourseSession[]

  @@map("courses")
}

// รุ่นอบรมของหลักสูตร
// status: OPEN, CLOSED, COMPLETED
model CourseSession {
  id                  Int       @id @default(autoincrement())
  courseId            Int       @map("course_id")
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name                String
  venue               String?
  startDate           DateTime? @map("start_date")
  endDate             DateTime? @map("end_date")
  applicationOpenDate DateTime? @map("application_open_date")
  applicationDeadline DateTime? @map("application_deadline")
  capacity            Int?
  status              String    @default("OPEN")
  createdAt           DateTime  @default(now()) @map("created_at")

  applications Application[]

  @@map("course_sessions")
}

// ใบสมัครเข้าอบรมของโค้ช
// status: PENDING, APPROVED, REJECTED, CANCELLED
model Application {
  id              Int           @id @default(autoincrement())
  coachId         Int           @map("coach_id")
  coach           Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  courseSessionId Int           @map("course_session_id")
  courseSession   CourseSession @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)
  status          String        @default("PENDING")
  appliedAt       DateTime      @default(now()) @map("applied_at")
  reviewedAt      DateTime?     @map("reviewed_at")
  reviewedBy      String?       @map("reviewed_by")
  note            String?

  @@unique([coachId, courseSessionId])
  @@map("applications")
}

// กิจกรรม/ปฏิทินกิจกรรมของสมาคม (นำเข้าจาก FA Thailand Technical Calendar)
// teamScope: Men, Women, Both, Coach Education
model Event {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  color     String
  teamScope String   @map("team_scope")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  sourceUrl String?  @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("events")
}

// ทีมที่เข้าร่วม G15 Women's Football Series
model G15Team {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String?  @map("logo_url")
  groupName String?  @map("group_name")
  createdAt DateTime @default(now()) @map("created_at")

  homeMatches   G15Match[] @relation("G15HomeTeam")
  awayMatches   G15Match[] @relation("G15AwayTeam")
  players       G15Player[]
  officials     G15Official[]
  goals         G15Goal[]
  substitutions G15Substitution[]
  cards         G15Card[]
  lineups       G15Lineup[]

  @@map("g15_teams")
}

// นักกีฬาที่ขึ้นทะเบียนของแต่ละทีม (จากแบบฟอร์มขึ้นทะเบียนนักกีฬาจริงของ FA Thailand)
// idCardNumber/passportNumber เป็นข้อมูลอ่อนไหว — เก็บไว้เป็นส่วนหนึ่งของทะเบียนทางการ
// แต่ไม่แสดงผลที่หน้าเว็บสาธารณะเลย (ไม่มี UI ใดอ่านค่าฟิลด์นี้ไปแสดง)
model G15Player {
  id             Int       @id @default(autoincrement())
  teamId         Int       @map("team_id")
  team           G15Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  no             Int?
  firstNameTh    String    @map("first_name_th")
  lastNameTh     String    @map("last_name_th")
  firstNameEn    String?   @map("first_name_en")
  lastNameEn     String?   @map("last_name_en")
  nationality    String?
  jerseyName     String?   @map("jersey_name")
  jerseyNumber   Int?      @map("jersey_number")
  position       String?
  dob            DateTime?
  weightKg       Float?    @map("weight_kg")
  heightCm       Float?    @map("height_cm")
  idCardNumber   String?   @map("id_card_number")
  passportNumber String?   @map("passport_number")
  createdAt      DateTime  @default(now()) @map("created_at")

  goals   G15Goal[]
  lineups G15Lineup[]

  @@map("g15_players")
}

// เจ้าหน้าที่ทีม (โค้ช/ผู้จัดการทีม ฯลฯ) ที่ขึ้นทะเบียนของแต่ละทีม — โครงสร้างเดียวกับ G15Player
model G15Official {
  id              Int       @id @default(autoincrement())
  teamId          Int       @map("team_id")
  team            G15Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  no              Int?
  firstNameTh     String    @map("first_name_th")
  lastNameTh      String    @map("last_name_th")
  firstNameEn     String?   @map("first_name_en")
  lastNameEn      String?   @map("last_name_en")
  gender          String?
  nationality     String?
  role            String?
  dob             DateTime?
  coachingLicense String?   @map("coaching_license")
  idCardNumber    String?   @map("id_card_number")
  passportNumber  String?   @map("passport_number")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("g15_officials")
}

// นัดการแข่งขัน G15 Women's Football Series
// status: SCHEDULED, FINISHED
model G15Match {
  id         Int       @id @default(autoincrement())
  round      String
  matchDate  DateTime? @map("match_date")
  venue      String?
  homeTeamId Int       @map("home_team_id")
  awayTeamId Int       @map("away_team_id")
  homeTeam   G15Team   @relation("G15HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam   G15Team   @relation("G15AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeScore  Int?      @map("home_score")
  awayScore  Int?      @map("away_score")
  status     String    @default("SCHEDULED")
  createdAt  DateTime  @default(now()) @map("created_at")

  // ทีมงานผู้ตัดสิน — จากใบรายงานผู้ตัดสิน/Starting List ของแต่ละนัด (มีเฉพาะนัดที่ได้รับเอกสารแล้ว)
  referee            String? @map("referee")
  assistantReferee1  String? @map("assistant_referee_1")
  assistantReferee2  String? @map("assistant_referee_2")
  fourthOfficial     String? @map("fourth_official")
  matchCommissioner  String? @map("match_commissioner")
  refereeAssessor    String? @map("referee_assessor")
  generalCoordinator String? @map("general_coordinator")

  // สกอร์แยกครึ่งเวลาตามที่ระบุในใบรายงานผู้ตัดสิน — เก็บไว้อ้างอิงเฉยๆ ไม่ใช่ค่าที่ใช้คำนวณตารางคะแนน
  // (homeScore/awayScore ด้านบนคือค่าทางการที่ใช้จริง อาจไม่ตรงกับผลรวมครึ่งแรก+ครึ่งหลังในเอกสารเสมอไป)
  firstHalfHomeScore  Int? @map("first_half_home_score")
  firstHalfAwayScore  Int? @map("first_half_away_score")
  secondHalfHomeScore Int? @map("second_half_home_score")
  secondHalfAwayScore Int? @map("second_half_away_score")

  goals         G15Goal[]
  substitutions G15Substitution[]
  cards         G15Card[]
  lineups       G15Lineup[]

  @@map("g15_matches")
}

// ไลน์อัพผู้เล่นของแต่ละนัด (จาก Starting List) — status: STARTING, SUBSTITUTE
model G15Lineup {
  id        Int       @id @default(autoincrement())
  matchId   Int       @map("match_id")
  match     G15Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId    Int       @map("team_id")
  team      G15Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  Int       @map("player_id")
  player    G15Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status    String    @default("STARTING") @map("status")
  isCaptain Boolean   @default(false) @map("is_captain")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([matchId, playerId])
  @@map("g15_lineups")
}

// ผู้ทำประตูในแต่ละนัด (จากใบรายงานผู้ตัดสิน หัวข้อ "7. ผู้ทำประตู")
model G15Goal {
  id           Int      @id @default(autoincrement())
  matchId      Int      @map("match_id")
  match        G15Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId       Int      @map("team_id")
  team         G15Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId     Int?     @map("player_id")
  player       G15Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerName   String   @map("player_name")
  jerseyNumber Int?     @map("jersey_number")
  minute       Int?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("g15_goals")
}

// การเปลี่ยนตัวผู้เล่นในแต่ละนัด (จากใบรายงานผู้ตัดสิน หัวข้อ "8. การเปลี่ยนตัวผู้เล่น")
model G15Substitution {
  id              Int      @id @default(autoincrement())
  matchId         Int      @map("match_id")
  match           G15Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId          Int      @map("team_id")
  team            G15Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  minute          Int?
  playerInName    String   @map("player_in_name")
  playerInNumber  Int?     @map("player_in_number")
  playerOutName   String   @map("player_out_name")
  playerOutNumber Int?     @map("player_out_number")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("g15_substitutions")
}

// ใบเหลือง/ใบแดง ของนักกีฬาและเจ้าหน้าที่ทีมในแต่ละนัด (จากใบรายงานผู้ตัดสิน หัวข้อ 9-12)
// holderRole: PLAYER, OFFICIAL — cardType: YELLOW, RED
model G15Card {
  id           Int      @id @default(autoincrement())
  matchId      Int      @map("match_id")
  match        G15Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId       Int      @map("team_id")
  team         G15Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  holderName   String   @map("holder_name")
  holderNumber Int?     @map("holder_number")
  holderRole   String   @default("PLAYER") @map("holder_role")
  cardType     String   @map("card_type")
  minute       Int?
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("g15_cards")
}

// ศูนย์ฝึกกิจกรรมของโครงการ Play and Learn เพลินให้สุดกับฟุตบอล
// coaches เก็บเป็นข้อความหลายบรรทัด (1 ชื่อต่อบรรทัด) เพื่อให้แก้ไขง่ายในฟอร์มเดียว ไม่ต้องทำตารางย่อย
model PlayAndLearnCenter {
  id          Int      @id @default(autoincrement())
  name        String
  province    String
  provinceEn  String   @map("province_en")
  address     String
  coaches     String
  coordinator String
  tel         String
  schedule    String?
  registerUrl String?  @map("register_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("play_and_learn_centers")
}

